# ignis.toml — copy to ignis.toml next to your app, or pass `ignis serve --config path`.
# Precedence, highest first: CLI flag > IGNIS_* environment variable > this file > default.
# Every key is optional; an unknown key is an error, not a silent default.

# PHP entry script every worker thread runs. For Symfony this is the app's own public/index.php
# (README.md#symfony, V-40); for a bare app it is any script that calls Ignis\serve(). Also
# accepted as `ignis serve app.php`.
entry = "examples/hello_server.php"

# host:port to listen on. Default 127.0.0.1:8080 — bind 0.0.0.0 yourself when you mean it.
listen = "127.0.0.1:8080"

# PHP worker threads. Default: the machine's available parallelism.
# threads = 4

# Respawn a worker whose script ends (fatal error, exit). Default true.
# supervise = true

# Extra php.ini — the embed SAPI has no -c/-d.
# php_ini = "/etc/ignis/php.ini"

# Log filter, RUST_LOG syntax. Default "warn": a worker respawn or a stalled thread is never silent.
# log = "warn"

# Path prefixes admitted regardless of the budget, so a saturated server can still be probed.
# exempt = ["/_ignis/", "/metrics"]

# Development reload (research 40, V-90). Watches the files PHP actually loads and brings the
# workers back with a change, one at a time, without closing the listener. Needs `supervise = true`;
# leave it off in production, where a stray write would reload the fleet.
# [watch]
# enabled = true
# settle_ms = 300          # quiet time before a change counts; one composer install is one reload
# reload_parallel = 1      # workers away at once; 1 keeps the reload invisible to clients

[budget]
# Request fibers admitted at once, per thread. Past it requests wait as data (a few hundred bytes
# each), never as a fiber (~15 kB). 0 = unlimited. Default 1024.
fibers = 1024
# Waiting requests before the answer is 503 + retry-after. 0 = unbounded. Default 4096.
queue = 4096

[limits]
# The front door's bounds. Each is also an IGNIS_* environment variable, and the environment wins.
#
# Connections held at once; over this the listener refuses rather than queueing. ADR-0025: V-37
# measured ~33 kB of RSS per held connection, so this is what bounds memory under load — the fiber
# budget above cannot, because a connection costs memory before it becomes a request.
max_connections = 8192
# Largest request body accepted; a bigger one is answered 413.
max_body_bytes = 8388608
# How long a connection may take to send its request head (slowloris).
header_timeout_ms = 10000
# How long an idle keep-alive connection is kept.
idle_timeout_ms = 60000
# How long in-flight requests get after SIGTERM before the process exits (V-56).
drain_timeout_ms = 10000

# ---- ADR-0043: stall detection, stuck-fiber recovery, blocking alerts -------------------------
# Every key below has a per-profile default; a key written here beats the profile and an
# IGNIS_* variable beats this file. Durations are milliseconds; 0 turns a level off.
# [recovery]
# profile = "production"        # production | load-test | test
# fiber_timeout_ms = 0          # L0: wall-clock ceiling per request, inherited by children
# park_timeout_ms = 0           # a single park (Ignis\sleep, await, a hooked read) may not outlast this; 30000 under IGNIS_CHAOS
# busy_warn_ms = 500            # warn when a worker runs PHP or blocks this long without yielding
# stall_kill_ms = 10000         # L3/L4: kill the fiber a stalled worker is running (SIGRTMIN+2)
# stall_abandon_ms = 30000      # L5: abandon the worker, fail its requests, spawn a replacement
# leaked_workers_max = 3        # health answers 503 past this many abandoned workers
# kill = "graceful"             # graceful (uncatchable engine exit) | exception (Ignis\KilledException)
# on_swallowed_cancel = "force-close"   # force-close | log
# [recovery.routes."/export/"]  # longest matching prefix wins
# fiber_timeout_ms = 120000
# stall_kill_ms = 0
# [blocking]
# mode = "warn"                 # off | warn | strict | fatal
# threshold_us = 1000           # a call that blocks a fiber's thread longer than this is reported
# trace = false                 # PHP backtrace on the first occurrence per site
# report = "/var/log/ignis-blocking.json"   # written at exit and on SIGUSR2
# allow = ["libphp:read@/config", "sqlite3.so"]
# [alerts]
# window_s = 60                 # one summary per key per window
# escalate_count = 100          # warn -> error at this many events in one window
# recover_windows = 5           # silent windows before a key is reported recovered
# max_lines_per_s = 20          # log lines the alert module may emit per second
