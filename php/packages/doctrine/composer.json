{
    "name": "ignis/doctrine",
    "description": "Doctrine ORM under Ignis fibers: one EntityManager per request instead of one per process, so two overlapping requests never share an identity map, and the transaction a request leaves open never becomes the next one's.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ignis/runtime": "@dev",
        "doctrine/orm": "^3.0",
        "doctrine/doctrine-bundle": "^2.12 || ^3.0",
        "doctrine/dbal": "^4.0",
        "symfony/config": "^7.0 || ^8.0",
        "symfony/dependency-injection": "^7.0 || ^8.0",
        "symfony/http-kernel": "^7.0 || ^8.0",
        "symfony/service-contracts": "^3.0",
        "psr/container": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Ignis\\Doctrine\\": "src/"
        }
    },
    "config": {
        "allow-plugins": false
    }
}
