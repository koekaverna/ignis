{
    "name": "ignis/revolt",
    "description": "Revolt event-loop driver backed by the Ignis reactor (E7): AMPHP libraries run unchanged, every await is a parked fiber.",
    "repositories": [
        {
            "type": "path",
            "url": "../runtime",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.1",
        "revolt/event-loop": "^1.0",
        "amphp/amp": "^3.0",
        "amphp/socket": "^2.0",
        "ignis/runtime": "@dev"
    },
    "config": {
        "preferred-install": "source",
        "allow-plugins": false
    },
    "autoload": {
        "psr-4": {
            "Ignis\\Revolt\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    },
    "license": "MIT"
}
