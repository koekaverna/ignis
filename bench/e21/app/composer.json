{
    "name": "ignis/fiber-scope-probe",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "symfony/framework-bundle": "^7.3",
        "symfony/security-bundle": "^7.3",
        "symfony/runtime": "^7.3",
        "symfony/yaml": "^7.3",
        "ignis/runtime": "@dev",
        "ignis/symfony-runtime": "@dev",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "ignis/doctrine": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../../php/packages/*",
            "options": {
                "symlink": false
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5.10"
        },
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "extra": {
        "runtime": {
            "class": "Ignis\\Symfony\\IgnisRuntime"
        }
    },
    "minimum-stability": "stable",
    "description": "E21 fixture: the smallest Symfony app that shows what two overlapping requests share. Not published."
}